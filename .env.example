# Neon Postgres (use the pooled connection string from the Neon console)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (Managed Better Auth) — Project → Auth → Configuration
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth"

# Cookie signing secret for Neon Auth session data (min 32 chars)
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Optional collector tokens (fixtures used when unset / scrape providers unavailable)
PH_DEV_TOKEN=""
YOUTUBE_API_KEY=""
AI_GATEWAY_API_KEY=""

# Protect /api/cron/tick in production (Vercel cron sends Authorization: Bearer …)
CRON_SECRET=""

# TinyFish Search + Fetch (preferred). Agent is last-resort only.
# https://github.com/tinyfish-io/tinyfish-cookbook/tree/main/tinyskills
TINYFISH_API_KEY=""

# Scavio structured scrapers (YouTube, Reddit, X, extract, etc.)
# Primary provider for Reddit + X. Arcade optional if you deploy arcade-scavio.
# https://scavio.dev/docs/  https://pypi.org/project/arcade-scavio/
SCAVIO_API_KEY=""
