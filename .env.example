# Neon Postgres (use the pooled connection string from the Neon console)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (Managed Better Auth) — Project → Auth → Configuration
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth"

# Cookie signing secret for Neon Auth session data (min 32 chars)
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Canonical app origin for digest links. Required at runtime in production-mode
# builds, including staging: set to that environment's origin, not production.
# Local development falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Legacy Product Hunt/YouTube tokens; metered production adapters are pending.
PH_DEV_TOKEN=""
YOUTUBE_API_KEY=""

# Protect /api/cron/tick; the Cloudflare scheduled handler sends this bearer secret.
CRON_SECRET=""

# Fixture fallback override. Collectors fail instead of returning bundled
# sample data when a provider path fails in production. Set to "true" only
# for intentional demo environments.
ALLOW_FIXTURES="false"

# Daily digest email via Resend (https://resend.com). Digests are skipped
# (not failed) when RESEND_API_KEY is unset.
RESEND_API_KEY=""
DIGEST_FROM_NAME="Vantage"
DIGEST_FROM_ADDRESS="digest@contextfor.dev"

# TinyFish Search + Fetch (preferred). Agent is last-resort only.
# https://github.com/tinyfish-io/tinyfish-cookbook/tree/main/tinyskills
TINYFISH_API_KEY=""

# Scavio structured scrapers (YouTube, Reddit, X, extract, etc.)
# Optional Reddit fallback, X acquisition, and indexed public LinkedIn discovery.
# https://scavio.dev/docs/  https://pypi.org/project/arcade-scavio/
SCAVIO_API_KEY=""
# Reddit posts per workspace per UTC day that Scavio hydrates with full text and top replies after a
# Firecrawl search (two Scavio requests each). Default 5; 0 turns hydration off.
REDDIT_HYDRATE_DAILY_MAX="5"
# Explicit current USD price per Scavio Google request; no guessed default.
SCAVIO_GOOGLE_COST_USD=""

# Paid integrations are manual and disabled by default. USD cap per provider per UTC day.
# Apply the pending migrations (community phase, provider_budget_reservation) before opting in.
# VANTAGE_PAID_DAILY_BUDGET_<PROVIDER>_USD overrides the global cap for one provider when it is
# positive (provider upper-cased, non-alphanumerics to _), e.g. VANTAGE_PAID_DAILY_BUDGET_DATAFORSEO_USD.
# Each provider without its own cap gets the global cap separately, so total daily paid spend can
# reach the sum of the caps, not the global cap alone.
VANTAGE_PAID_PROVIDERS_ENABLED="false"
VANTAGE_PAID_DAILY_BUDGET_USD=""
AI_GATEWAY_API_KEY=""
# Optional Cloudflare AI Gateway compat endpoint for draft models, e.g.
# https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/compat. Set both or neither;
# with CF_AIG_BASE_URL unset, drafts use AI_GATEWAY_API_KEY as before.
CF_AIG_BASE_URL=""
CF_AIG_TOKEN=""
FIRECRAWL_API_KEY=""
# Your purchased Firecrawl credit price in USD (required for Alexandria and the
# forum/blog search fallback; both also need the paid opt-in and daily budget above).
FIRECRAWL_CREDIT_USD=""
# DataForSEO (backlinks and SERP data). Paid calls also need VANTAGE_PAID_PROVIDERS_ENABLED="true"
# and a positive VANTAGE_PAID_DAILY_BUDGET_DATAFORSEO_USD or VANTAGE_PAID_DAILY_BUDGET_USD above.
# DATAFORSEO_ENV is "sandbox" unless exactly "live".
# In production, sandbox is refused unless ALLOW_FIXTURES="true"; staging runs NODE_ENV=production, so it needs that to use the sandbox.
# DATAFORSEO_USERNAME is accepted as an alias for DATAFORSEO_LOGIN; LOGIN wins when both are set.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
DATAFORSEO_ENV=""
# USD caps and alert thresholds; blank or invalid values fall back to 5, 15 and 30.
# DataForSEO spend draws on the dataforseo provider cap (VANTAGE_PAID_DAILY_BUDGET_DATAFORSEO_USD, or the global cap when unset), so size that to cover DATAFORSEO_DAILY_BUDGET_USD.
DATAFORSEO_DAILY_BUDGET_USD=""
DATAFORSEO_RESERVE_FLOOR_USD=""
DATAFORSEO_ALERT_BALANCE_USD=""
# SEO/GEO agent (AI Gateway models). Blank values use the defaults.
# SEO_AGENT_MODEL: executor model id (default anthropic/claude-sonnet-5.5).
SEO_AGENT_MODEL=""
# SEO_CLASSIFIER_MODEL: intent classifier and concept-answer model (default reflection/beam).
SEO_CLASSIFIER_MODEL=""
# SEO_CLASSIFIER_SPEED: optional gateway speed hint sent with classifier calls; unset sends none.
SEO_CLASSIFIER_SPEED=""
# SEO_AGENT_FALLBACK_MODEL: model retried once when the executor refuses before any content; unset disables the retry.
SEO_AGENT_FALLBACK_MODEL=""
# SEO_AGENT_AUTO_CREDITS: DataForSEO credits one question may spend before asking (default 3).
SEO_AGENT_AUTO_CREDITS=""
# SEO_AGENT_GEO_ALWAYS_ASK: only the exact value "false" lets GEO (llm_response) calls run without approval (default on).
SEO_AGENT_GEO_ALWAYS_ASK=""
# SEO_MODEL_PRICES_JSON: USD per million tokens, {"<model>":{"input":n,"output":n,"cacheRead":n}}, merged over the built-in prices.
SEO_MODEL_PRICES_JSON=""
# DATAFORSEO_LLM_MODEL_<ENGINE>: pins the LLM model for one engine (CHAT_GPT, CLAUDE, GEMINI, PERPLEXITY); unset discovers it.
# Analyze Scavio-acquired X posts with Grok through AI Gateway; native X search unverified.
X_GATEWAY_EXPERIMENT_ENABLED="false"
X_GATEWAY_MODEL="spacexai/grok-4.7"
# COMMENT_DRAFT_MODEL alternative: anthropic/claude-sonnet-5.5. Verified models only.
COMMENT_DRAFT_MODEL="openai/gpt-6.1-sol"
# Optional cheaper manual triage before premium drafting, using api.inco.ai/v1.
INCO_API_KEY=""
INCO_TRIAGE_ENABLED="false"
# Development-only fixtures. Ignored in production.
VANTAGE_DEMO_FIXTURES="false"

# Slice 6 conservative per-workspace learning. Off by default: with this flag
# unset the deterministic baseline ranker is used verbatim and no preference
# weight can affect ranking. Roll back instantly by setting it back to "false".
VANTAGE_LEARNING_ENABLED="false"
# Workspace outcome decisions required before any weight may apply.
VANTAGE_LEARNING_MIN_EVIDENCE="20"
# Per-key decisions required before that key carries weight.
VANTAGE_LEARNING_MIN_KEY_EVIDENCE="3"
# Hard cap on the total score change learning may make (0..1).
VANTAGE_LEARNING_MAX_DELTA="0.06"
# Hard cap on a single key's absolute weight (0..1).
VANTAGE_LEARNING_MAX_WEIGHT="0.2"
# Largest offline rank displacement tolerated before enablement is blocked.
VANTAGE_LEARNING_MAX_RANK_SHIFT="3"
# Cutoff used by offline replay metrics; matches the Opportunity Queue limit.
VANTAGE_LEARNING_K="5"

# Public endpoint guard (S06). Daily dollar cap shared by all unauthenticated,
# cost-bearing routes (default 5).
PUBLIC_DAILY_BUDGET_USD="5"
# Cloudflare Turnstile secret. Required: with it unset the guard fails closed
# (503) unless TURNSTILE_DEV_BYPASS is "true", which is ignored in production.
# Staging may use Cloudflare's published always-pass test secret.
TURNSTILE_SECRET_KEY=""
# Local development only: skip Turnstile when no secret is set.
TURNSTILE_DEV_BYPASS=""
# Enables the no-cost /api/public/ping test route (off unless exactly "true"). Set it on staging and in tests
# to exercise the public guard; never set it on production.
ENABLE_PUBLIC_PING=""
# Salt mixed with the client IP and the UTC day before hashing. Required in
# production. Generate with: openssl rand -base64 32
VISITOR_SALT=""

# Comma-separated Neon Auth user ids allowed to use /admin/switches and
# /api/admin/switches. Empty or unset means nobody (everyone gets 404).
VANTAGE_ADMIN_USER_IDS=""

# Polar billing (https://polar.sh). Server-side only; never commit real values.
# Organization access token from Polar → Settings → Developers (sandbox and production tokens differ).
POLAR_ACCESS_TOKEN=""
# Secret shown when you add the webhook endpoint (…/api/webhooks/polar) in Polar → Settings → Webhooks.
POLAR_WEBHOOK_SECRET=""
# "sandbox" (default; any other value) or "production". Keep sandbox until live keys are confirmed.
POLAR_SERVER="sandbox"
