---
import Base from '../layouts/Base.astro';
import { getPublishedPosts, postPath } from '../lib/posts';

const posts = await getPublishedPosts();
---
<Base title="Vantage Blog" description="Insights and playbooks from the Vantage team on staying ahead of the field.">
  <h1>Blog</h1>
  <ul>
    {posts.map((p) => (
      <li>
        <a href={postPath(p)}>{p.data.title}</a>
        <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
        <p>{p.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
