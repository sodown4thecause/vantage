# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare / opennext (local dev state — secrets come from dashboard/wrangler)
.wrangler/
.dev.vars
.dev.vars.*
/.open-next/

# neon cli local state (org/project/branch pointers — env specific, not secret)
.neon

# local agent tooling state
/.agents/skills/
/.warp/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts
