{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dontkillmyvibe",
	"main": "worker-entry.mjs",
	"build": { "command": "pnpm run cf:build" },
	"previews": {},
	"compatibility_date": "2026-10-05",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "dontkillmyvibe"
		}
	],
	"browser": { "binding": "BROWSER" },
	"ai": { "binding": "AI" },
	"vectorize": [{ "binding": "VECTORIZE", "index_name": "vantage-docs" }],
	"vars": { "VANTAGE_SEMANTIC_MODE": "off" },
	"ratelimits": [
		{ "name": "RADAR_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
	],
	"triggers": {
		"crons": []
	},
	"env": {
		"staging": {
			"name": "vantage-staging",
			"build": { "command": "" },
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "vantage-staging" }],
			"browser": { "binding": "BROWSER" },
			"ai": { "binding": "AI" },
			"vectorize": [{ "binding": "VECTORIZE", "index_name": "vantage-docs-staging" }],
			"vars": { "VANTAGE_SEMANTIC_MODE": "shadow" },
			"ratelimits": [
				{ "name": "RADAR_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
			],
			"triggers": { "crons": ["0 */3 * * *"] }
		},
		"production": {
			"name": "dontkillmyvibe",
			"build": { "command": "" },
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "dontkillmyvibe" }],
			"browser": { "binding": "BROWSER" },
			"ai": { "binding": "AI" },
			"vectorize": [{ "binding": "VECTORIZE", "index_name": "vantage-docs" }],
			"vars": { "VANTAGE_SEMANTIC_MODE": "off" },
			"ratelimits": [
				{ "name": "RADAR_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
			],
			"triggers": { "crons": [] }
		}
	},
	"observability": {
		"enabled": true
	}
}
