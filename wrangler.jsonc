{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vantage",
	"main": "worker-entry.mjs",
	"compatibility_date": "2026-10-05",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "vantage"
		}
	],
	"triggers": {
		"crons": []
	},
	"env": {
		"staging": {
			"name": "vantage-staging",
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "vantage-staging" }],
			"triggers": { "crons": [] }
		},
		"production": {
			"name": "vantage",
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "vantage" }],
			"triggers": { "crons": [] }
		}
	},
	"observability": {
		"enabled": true
	}
}
