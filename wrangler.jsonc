{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dontkillmyvibe",
	"main": "worker-entry.mjs",
	"build": { "command": "pnpm run cf:build" },
	"previews": {},
	"compatibility_date": "2026-10-05",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "dontkillmyvibe"
		}
	],
	"triggers": {
		"crons": []
	},
	"env": {
		"staging": {
			"name": "vantage-staging",
			"build": { "command": "" },
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "vantage-staging" }],
			"triggers": { "crons": ["0 */3 * * *"] }
		},
		"production": {
			"name": "dontkillmyvibe",
			"build": { "command": "" },
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "dontkillmyvibe" }],
			"triggers": { "crons": [] }
		}
	},
	"observability": {
		"enabled": true
	}
}
